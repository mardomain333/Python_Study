    if a[0]>last:
      count+=1
      last=a[1]
print(count)



values = [60, 100, 120]
weights = [10, 20, 30]
W = 50
item=[]
result=0
for i in range(len(values)):
    ratio=values[i]//weights[i]
    item.append((ratio,values[i],weights[i]))
item.sort(reverse=True)
for ratio,values,weights in item:
    if weights<W:
        result+=values
        W-=weights
    else:
        result+=ratio*W
        break
print(result)



jobs = [
    ('A', 2, 100),
    ('B', 1, 19),
    ('C', 2, 27),
    ('D', 1, 25),
    ('E', 3, 15)
]



profit=0
maxdeadline=max(jobs[i][1] for i in range(len(jobs)))
parent=[i for i in range(maxdeadline+1)]
def find(x):
    if parent[x]!=x:
        return find(parent[x])
    else:
        return parent[x]
persons=[]
jobs.sort(key=lambda x:x[2],reverse=True)
for name,deadline,pro in jobs:
   availablitiy=find(deadline)
   if availablitiy>0:
       profit+=pro
       parent[availablitiy]-=1
       persons.append(name)
print(persons)
print(profit)  

