#fixed size slideing window

#finding the maxsub array sum of size k

arr = [1,2,3,1,2,-3,2,3,3]
k = 3

currentsum=sum(arr[:k])
temp=currentsum
l=0
for r in range(k,len(arr)):
    temp+=arr[r]
    temp-=arr[l]
    l+=1
    if temp>currentsum:
        currentsum=max(temp,currentsum)
        large=arr[l:r+1]
print(currentsum)
print(large)

#longest substring without repeating characters



l=0
start=0
end=0
s = "abcabcbb"
s="adjflkjsfie"
longest=0
repeated=set()
for r in range(len(s)):
    while(s[r] in repeated):
        l+=1
        repeated.remove(s[l])
    repeated.add(s[r])
    lent=(r-l)+1
    if longest<lent:
        start=l
        end=r
        longest=lent

print(longest)
print(s[start+1:end+1])

