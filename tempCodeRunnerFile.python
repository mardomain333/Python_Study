Input= "aabacbebebe" 

l=0
start=0
end=0
longest=0

dic={}

for r in range(len(Input)):
    dic[Input[r]]=dic.get(Input[r],0)+1
    while(len(dic)>k):
        dic[Input[l]]=dic.get(Input[l],0)-1
        if dic[Input[l]]==0:
            del dic[Input[l]]
        l+=1
    




    lent=(r-l)+1
    if lent>longest:
        start=l
        end=r
        longest=lent

print(longest)
print(Input[start:end+1])


Input= "aabacbebebe"

l=0
longest=0

dic={}
start=end=0
for r in range(len(Input)):
    dic[Input[r]]=dic.get(Input[r],0)+1
    while(len(dic)>k):
        dic[Input[l]]=dic.get(Input[l],0)-1
       
        if dic[Input[l]]==0:
            del dic[Input[l]]
        
        l+=1


    lent=(r-l)+1
    if lent>longest:
        longest=lent
        start=l
        end=r
print(Input[start:end+1])
